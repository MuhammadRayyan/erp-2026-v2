generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum EntitlementValueType {
  BOOLEAN
  LIMIT
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum IndustryProfileKey {
  GENERAL_SERVICES
  TECHNICAL_SERVICES
  AUTOMOTIVE_WORKSHOP
  CIVIL_ARCHITECTURAL
  GENERAL_TRADING
}

enum VatRegistrationStatus {
  NOT_REGISTERED
  REGISTERED
  DEREGISTERED
}

enum DocumentLanguage {
  ENGLISH
  ARABIC
  BILINGUAL
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                  Session[]
  accounts                  Account[]
  memberships               TenantMembership[]
  onboarding                OnboardingOperation[]
  invitationsSent           TenantInvitation[]   @relation("InvitationSender")
  invitationsAccepted       TenantInvitation[]   @relation("InvitationAcceptor")
  auditEvents                AuditEvent[]          @relation("AuditEventActor")
  catalogImportsCreated      CatalogImportBatch[] @relation("CatalogImportCreator")
  customFieldValuesUpdated   CustomFieldValue[]   @relation("CustomFieldValueUpdater")
  exportsRequested           ExportRun[]          @relation("ExportRequester")
  numberAllocationsCreated   NumberAllocation[]   @relation("NumberAllocator")
  numberAllocationsVoided    NumberAllocation[]   @relation("NumberVoider")
  filesUploaded              StoredFile[]         @relation("FileUploader")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                  String?
  idToken                String?
  password              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model Tenant {
  id                   String       @id @default(cuid())
  slug                 String       @unique
  name                 String
  status               TenantStatus @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  memberships          TenantMembership[]
  businesses           Business[]
  onboarding           OnboardingOperation[]
  invitations          TenantInvitation[]
  subscription         TenantSubscription?
  entitlementOverrides TenantEntitlementOverride[]
  emailOutbox           EmailOutbox[]
}

model TenantMembership {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String
  status     MembershipStatus @default(INVITED)
  isOwner    Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businesses BusinessMembership[]

  @@unique([tenantId, userId])
  @@index([userId, status])
}

model Business {
  id                     String   @id @default(cuid())
  tenantId               String
  slug                   String
  legalName              String
  tradingName            String?
  countryCode            String   @default("AE")
  baseCurrency           String   @default("AED")
  timezone               String   @default("Asia/Dubai")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profile                BusinessProfile?
  memberships            BusinessMembership[]
  onboarding             OnboardingOperation[]
  invitationGrants       BusinessInvitationGrant[]
  units                  UnitOfMeasure[]
  catalogItems           CatalogItem[]
  catalogImportBatches   CatalogImportBatch[]
  parties                Party[]
  storedFiles            StoredFile[]
  auditEvents            AuditEvent[]
  numberSequences        NumberSequence[]
  exportRuns             ExportRun[]
  customFieldDefinitions CustomFieldDefinition[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model BusinessProfile {
  id                       String                @id @default(cuid())
  tenantId                 String
  businessId               String                @unique
  industryProfile          IndustryProfileKey?
  legalForm                String?
  tradeLicenseNumber       String?
  tradeLicenseAuthority    String?
  vatRegistrationStatus    VatRegistrationStatus @default(NOT_REGISTERED)
  trn                      String?
  vatEffectiveFrom         DateTime?
  fiscalYearStartMonth     Int                    @default(1)
  documentLanguage         DocumentLanguage       @default(ENGLISH)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  business                 Business               @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, businessId])
  @@index([tenantId, industryProfile])
  @@index([tenantId, vatRegistrationStatus])
}

model BusinessMembership {
  id         String           @id @default(cuid())
  tenantId   String
  businessId String
  userId     String
  roleKey    String
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  business   Business         @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)
  tenantUser TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([tenantId, userId, status])
}

model TenantInvitation {
  id               String           @id @default(cuid())
  tenantId         String
  email            String
  tokenDigest      String           @unique
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  invitedByUserId  String
  acceptedByUserId String?
  acceptedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy        User             @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?            @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  businessGrants   BusinessInvitationGrant[]

  @@unique([tenantId, id])
  @@index([tenantId, status, expiresAt])
  @@index([email, status])
}

model BusinessInvitationGrant {
  id           String           @id @default(cuid())
  invitationId String
  tenantId     String
  businessId   String
  roleKey      String
  invitation   TenantInvitation @relation(fields: [tenantId, invitationId], references: [tenantId, id], onDelete: Cascade, map: "BusinessInvitationGrant_invitation_scope_fkey")
  business     Business         @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)

  @@unique([invitationId, businessId])
  @@index([tenantId, businessId])
}

model FeatureDefinition {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  description String?
  valueType   EntitlementValueType
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  plans       PlanEntitlement[]
  overrides   TenantEntitlementOverride[]
}

model Plan {
  id            String               @id @default(cuid())
  key           String               @unique
  name          String
  description   String?
  isInternal    Boolean              @default(false)
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  entitlements  PlanEntitlement[]
  subscriptions TenantSubscription[]
}

model PlanEntitlement {
  id         String            @id @default(cuid())
  planId     String
  featureId  String
  enabled    Boolean?
  limitValue Int?
  unlimited  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  plan       Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature    FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
}

model TenantSubscription {
  id        String             @id @default(cuid())
  tenantId  String             @unique
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, status])
}

model TenantEntitlementOverride {
  id         String            @id @default(cuid())
  tenantId   String
  featureId  String
  enabled    Boolean?
  limitValue Int?
  unlimited  Boolean           @default(false)
  reason     String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature    FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureId])
  @@index([featureId])
}

model OnboardingOperation {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  userId         String
  tenantId       String
  businessId     String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  business       Business @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Restrict)

  @@index([userId, createdAt])
}
