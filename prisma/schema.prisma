generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions             Session[]
  accounts             Account[]
  memberships          TenantMembership[]
  onboarding           OnboardingOperation[]
  invitationsSent      TenantInvitation[] @relation("InvitationSender")
  invitationsAccepted  TenantInvitation[] @relation("InvitationAcceptor")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model Tenant {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships TenantMembership[]
  businesses  Business[]
  onboarding  OnboardingOperation[]
  invitations TenantInvitation[]
}

model TenantMembership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  status    MembershipStatus @default(INVITED)
  isOwner   Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businesses BusinessMembership[]

  @@unique([tenantId, userId])
  @@index([userId, status])
}

model Business {
  id               String   @id @default(cuid())
  tenantId         String
  slug             String
  legalName        String
  tradingName      String?
  countryCode      String   @default("AE")
  baseCurrency     String   @default("AED")
  timezone         String   @default("Asia/Dubai")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships      BusinessMembership[]
  onboarding       OnboardingOperation[]
  invitationGrants BusinessInvitationGrant[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId])
}

model BusinessMembership {
  id         String           @id @default(cuid())
  tenantId   String
  businessId String
  userId     String
  roleKey    String
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  business   Business         @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)
  tenantUser TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([tenantId, userId, status])
}

model TenantInvitation {
  id               String            @id @default(cuid())
  tenantId         String
  email            String
  tokenDigest      String            @unique
  status           InvitationStatus  @default(PENDING)
  expiresAt        DateTime
  invitedByUserId  String
  acceptedByUserId String?
  acceptedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy        User              @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?             @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  businessGrants   BusinessInvitationGrant[]

  @@index([tenantId, status, expiresAt])
  @@index([email, status])
}

model BusinessInvitationGrant {
  id           String           @id @default(cuid())
  invitationId String
  tenantId     String
  businessId   String
  roleKey      String
  invitation   TenantInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  business     Business         @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)

  @@unique([invitationId, businessId])
  @@index([tenantId, businessId])
}

model OnboardingOperation {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  userId         String
  tenantId       String
  businessId     String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  business       Business @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Restrict)

  @@index([userId, createdAt])
}
