enum AccountClass {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountNormalBalance {
  DEBIT
  CREDIT
}

enum AccountKind {
  HEADER
  POSTING
  CONTROL
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum AccountType {
  GENERAL
  CASH
  BANK
  ACCOUNTS_RECEIVABLE
  INVENTORY
  PREPAYMENT
  VAT_INPUT
  OTHER_CURRENT_ASSET
  FIXED_ASSET
  ACCUMULATED_DEPRECIATION
  ACCOUNTS_PAYABLE
  VAT_OUTPUT
  ACCRUED_EXPENSE
  OTHER_CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  OWNER_EQUITY
  RETAINED_EARNINGS
  SALES_REVENUE
  SERVICE_REVENUE
  OTHER_INCOME
  COST_OF_GOODS_SOLD
  DIRECT_COST
  OPERATING_EXPENSE
  DEPRECIATION_EXPENSE
  OTHER_EXPENSE
}

enum AccountingPeriodStatus {
  OPEN
  SOFT_LOCKED
  CLOSED
}

enum JournalEntryStatus {
  PENDING
  POSTED
}

enum JournalEntryOrigin {
  SYSTEM
  MANUAL
  REVERSAL
}

model LedgerAccount {
  id                   String               @id @default(cuid())
  tenantId             String
  businessId           String
  code                 String
  name                 String
  description          String?
  class                AccountClass
  type                 AccountType
  normalBalance        AccountNormalBalance
  kind                 AccountKind
  isContra             Boolean              @default(false)
  manualPostingAllowed Boolean              @default(true)
  systemKey            String?
  systemManaged        Boolean              @default(false)
  required             Boolean              @default(false)
  status               AccountStatus        @default(ACTIVE)
  parentId             String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  business             Business             @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade, map: "LedgerAccount_business_scope_fkey")
  parent               LedgerAccount?       @relation("LedgerAccountHierarchy", fields: [tenantId, businessId, parentId], references: [tenantId, businessId, id], onDelete: Restrict, map: "LedgerAccount_parent_scope_fkey")
  children             LedgerAccount[]      @relation("LedgerAccountHierarchy")
  journalLines         JournalLine[]

  @@unique([tenantId, businessId, id], map: "LedgerAccount_scope_id_key")
  @@unique([tenantId, businessId, code], map: "LedgerAccount_scope_code_key")
  @@unique([tenantId, businessId, systemKey], map: "LedgerAccount_scope_system_key")
  @@index([tenantId, businessId, class, status, code], map: "LedgerAccount_register_idx")
  @@index([tenantId, businessId, parentId, status], map: "LedgerAccount_parent_status_idx")
}

model AccountingPeriod {
  id              String                 @id @default(cuid())
  tenantId        String
  businessId      String
  name            String
  startDate       DateTime               @db.Date
  endDate         DateTime               @db.Date
  status          AccountingPeriodStatus @default(OPEN)
  statusReason    String?
  statusChangedAt DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  business        Business               @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade, map: "AccountingPeriod_business_scope_fkey")

  @@unique([tenantId, businessId, id], map: "AccountingPeriod_scope_id_key")
  @@unique([tenantId, businessId, startDate, endDate], map: "AccountingPeriod_scope_dates_key")
  @@index([tenantId, businessId, startDate, endDate], map: "AccountingPeriod_register_idx")
  @@index([tenantId, businessId, status, startDate], map: "AccountingPeriod_status_idx")
}

model JournalEntry {
  id             String             @id @default(cuid())
  tenantId       String
  businessId     String
  postingDate    DateTime           @db.Date
  currencyCode   String             @db.VarChar(3)
  status         JournalEntryStatus @default(PENDING)
  origin         JournalEntryOrigin
  sourceType     String
  sourceId       String
  idempotencyKey String
  payloadHash    String             @db.VarChar(64)
  memo           String?
  reversalOfId   String?
  postedAt       DateTime?
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  business       Business           @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Restrict, map: "JournalEntry_business_scope_fkey")
  createdBy      User               @relation(fields: [createdById], references: [id], onDelete: Restrict, map: "JournalEntry_creator_fkey")
  reversalOf     JournalEntry?      @relation("JournalEntryReversal", fields: [tenantId, businessId, reversalOfId], references: [tenantId, businessId, id], onDelete: Restrict, map: "JournalEntry_reversal_scope_fkey")
  reversedBy     JournalEntry[]     @relation("JournalEntryReversal")
  lines          JournalLine[]

  @@unique([tenantId, businessId, id], map: "JournalEntry_scope_id_key")
  @@unique([tenantId, businessId, sourceType, sourceId], map: "JournalEntry_source_key")
  @@unique([tenantId, businessId, idempotencyKey], map: "JournalEntry_idempotency_key")
  @@unique([tenantId, businessId, reversalOfId], map: "JournalEntry_reversal_key")
  @@index([tenantId, businessId, postingDate, id], map: "JournalEntry_register_idx")
  @@index([tenantId, businessId, status, postedAt], map: "JournalEntry_status_idx")
}

model JournalLine {
  id             String        @id @default(cuid())
  tenantId       String
  businessId     String
  journalEntryId String
  lineNumber     Int
  accountId      String
  description    String?
  debit          Decimal       @default(0) @db.Decimal(20, 4)
  credit         Decimal       @default(0) @db.Decimal(20, 4)
  createdAt      DateTime      @default(now())
  journalEntry   JournalEntry  @relation(fields: [tenantId, businessId, journalEntryId], references: [tenantId, businessId, id], onDelete: Cascade, map: "JournalLine_entry_scope_fkey")
  account        LedgerAccount @relation(fields: [tenantId, businessId, accountId], references: [tenantId, businessId, id], onDelete: Restrict, map: "JournalLine_account_scope_fkey")

  @@unique([tenantId, businessId, id], map: "JournalLine_scope_id_key")
  @@unique([tenantId, businessId, journalEntryId, lineNumber], map: "JournalLine_number_key")
  @@index([tenantId, businessId, accountId, journalEntryId], map: "JournalLine_account_idx")
}
