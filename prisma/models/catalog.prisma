enum CatalogItemType {
  PRODUCT
  SERVICE
}

enum CatalogItemStatus {
  ACTIVE
  INACTIVE
}

enum UnitDimension {
  COUNT
  LENGTH
  AREA
  VOLUME
  MASS
  TIME
  OTHER
}

enum CatalogTaxCategory {
  UNSPECIFIED
  STANDARD_RATE
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
}

enum CatalogImportStatus {
  PREVIEW
  COMMITTED
  CANCELLED
}

enum CatalogImportAction {
  CREATE
  UPDATE
  SKIP
  CONFLICT
  INVALID
}

model UnitOfMeasure {
  id            String        @id @default(cuid())
  tenantId      String
  businessId    String
  code          String
  name          String
  symbol        String?
  dimension     UnitDimension @default(OTHER)
  decimalPlaces Int           @default(2)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  business      Business      @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade, map: "UnitOfMeasure_business_fkey")
  items         CatalogItem[]

  @@unique([tenantId, businessId, id])
  @@unique([tenantId, businessId, code])
  @@index([tenantId, businessId, active, name])
}

model CatalogItem {
  id                         String             @id @default(cuid())
  tenantId                   String
  businessId                 String
  type                       CatalogItemType
  status                     CatalogItemStatus  @default(ACTIVE)
  sku                        String?
  name                       String
  description                String?
  unitId                     String
  salesEnabled               Boolean            @default(true)
  purchaseEnabled            Boolean            @default(true)
  defaultSalesPrice          Decimal?           @db.Decimal(19, 4)
  defaultPurchasePrice       Decimal?           @db.Decimal(19, 4)
  salesAccountClassKey       String
  purchaseAccountClassKey    String
  defaultSalesTaxCategory    CatalogTaxCategory @default(UNSPECIFIED)
  defaultPurchaseTaxCategory CatalogTaxCategory @default(UNSPECIFIED)
  searchText                 String
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  business                   Business           @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade, map: "CatalogItem_business_fkey")
  unit                       UnitOfMeasure      @relation(fields: [tenantId, businessId, unitId], references: [tenantId, businessId, id], onDelete: Restrict, map: "CatalogItem_unit_fkey")
  importRows                 CatalogImportRow[] @relation("CatalogImportExistingItem")

  @@unique([tenantId, businessId, id])
  @@unique([tenantId, businessId, sku])
  @@index([tenantId, businessId, status, type, name])
  @@index([tenantId, businessId, unitId])
}

model CatalogImportBatch {
  id           String              @id @default(cuid())
  tenantId     String
  businessId   String
  createdById  String
  sourceName   String
  status       CatalogImportStatus @default(PREVIEW)
  totalRows    Int
  createdAt    DateTime            @default(now())
  committedAt  DateTime?
  cancelledAt  DateTime?
  business     Business            @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade, map: "CatalogImportBatch_business_scope_fkey")
  createdBy    User                @relation("CatalogImportCreator", fields: [createdById], references: [id], onDelete: Restrict, map: "CatalogImportBatch_createdById_fkey")
  rows         CatalogImportRow[]

  @@unique([tenantId, businessId, id])
  @@index([tenantId, businessId, status, createdAt])
}

model CatalogImportRow {
  id                    String              @id @default(cuid())
  tenantId              String
  businessId            String
  batchId               String
  rowNumber             Int
  rawData               Json
  normalizedData        Json?
  action                CatalogImportAction
  existingItemId        String?
  existingItemUpdatedAt DateTime?
  issues                Json
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  batch                 CatalogImportBatch  @relation(fields: [tenantId, businessId, batchId], references: [tenantId, businessId, id], onDelete: Cascade, map: "CatalogImportRow_batch_scope_fkey")
  existingItem          CatalogItem?        @relation("CatalogImportExistingItem", fields: [tenantId, businessId, existingItemId], references: [tenantId, businessId, id], onDelete: Restrict, map: "CatalogImportRow_existing_item_scope_fkey")

  @@unique([batchId, rowNumber])
  @@index([tenantId, businessId, batchId, action])
  @@index([tenantId, businessId, existingItemId])
}
