enum EmailOutboxStatus {
  PENDING
  PROCESSING
  RETRY
  SENT
  FAILED
  EXPIRED
  CANCELLED
}

enum EmailOutboxCategory {
  TENANT_INVITATION
  PASSWORD_RESET
  SYSTEM
}

model EmailOutbox {
  id                String              @id @default(cuid())
  tenantId          String?
  category          EmailOutboxCategory
  recipient         String
  subject           String
  textBody          String?
  htmlBody          String?
  status            EmailOutboxStatus   @default(PENDING)
  idempotencyKey    String              @unique
  correlationType   String?
  correlationId     String?
  expiresAt         DateTime?
  availableAt       DateTime            @default(now())
  attempts          Int                 @default(0)
  maxAttempts       Int                 @default(5)
  lockedAt          DateTime?
  lockedBy          String?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  providerMessageId String?
  lastError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "EmailOutbox_tenant_fkey")

  @@index([status, availableAt, createdAt])
  @@index([tenantId, createdAt])
  @@index([correlationType, correlationId])
}
