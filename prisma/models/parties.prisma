enum PartyType {
  ORGANIZATION
  INDIVIDUAL
}

enum PartyStatus {
  ACTIVE
  INACTIVE
}

enum PartyRoleKey {
  CUSTOMER
  SUPPLIER
}

enum PartyAddressType {
  BILLING
  DELIVERY
  SITE
  OTHER
}

enum PartyDuplicateReviewStatus {
  OPEN
  CONFIRMED
  DISMISSED
}

model Party {
  id                       String                 @id @default(cuid())
  tenantId                 String
  businessId               String
  type                     PartyType
  status                   PartyStatus            @default(ACTIVE)
  displayName              String
  legalName                String?
  firstName                String?
  lastName                 String?
  email                    String?
  phone                    String?
  taxRegistrationNumber    String?
  notes                    String?
  searchText               String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  business                 Business               @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade, map: "Party_business_fkey")
  roles                    PartyRole[]
  contacts                 PartyContact[]
  addresses                PartyAddress[]
  duplicateReviewsAsFirst  PartyDuplicateReview[] @relation("DuplicateFirstParty")
  duplicateReviewsAsSecond PartyDuplicateReview[] @relation("DuplicateSecondParty")

  @@unique([tenantId, businessId, id])
  @@index([tenantId, businessId, status, displayName])
  @@index([tenantId, businessId, taxRegistrationNumber])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Party_search_text_trgm_idx")
}

model PartyRole {
  id         String       @id @default(cuid())
  tenantId   String
  businessId String
  partyId    String
  role       PartyRoleKey
  createdAt  DateTime     @default(now())
  party      Party        @relation(fields: [tenantId, businessId, partyId], references: [tenantId, businessId, id], onDelete: Cascade, map: "PartyRole_party_fkey")

  @@unique([partyId, role])
  @@index([tenantId, businessId, role])
}

model PartyContact {
  id         String   @id @default(cuid())
  tenantId   String
  businessId String
  partyId    String
  name       String
  jobTitle   String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  party      Party    @relation(fields: [tenantId, businessId, partyId], references: [tenantId, businessId, id], onDelete: Cascade, map: "PartyContact_party_fkey")

  @@index([tenantId, businessId, partyId])
  @@index([tenantId, businessId, email])
}

model PartyAddress {
  id          String           @id @default(cuid())
  tenantId    String
  businessId  String
  partyId     String
  type        PartyAddressType
  label       String?
  line1       String
  line2       String?
  city        String?
  emirate     String?
  postalCode  String?
  countryCode String           @default("AE")
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  party       Party            @relation(fields: [tenantId, businessId, partyId], references: [tenantId, businessId, id], onDelete: Cascade, map: "PartyAddress_party_fkey")

  @@index([tenantId, businessId, partyId, type])
}

model PartyDuplicateReview {
  id               String                     @id @default(cuid())
  tenantId         String
  businessId       String
  firstPartyId     String
  secondPartyId    String
  status           PartyDuplicateReviewStatus @default(OPEN)
  score            Float
  evidence         Json
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  firstParty       Party                      @relation("DuplicateFirstParty", fields: [tenantId, businessId, firstPartyId], references: [tenantId, businessId, id], onDelete: Cascade, map: "PartyDuplicateReview_firstParty_fkey")
  secondParty      Party                      @relation("DuplicateSecondParty", fields: [tenantId, businessId, secondPartyId], references: [tenantId, businessId, id], onDelete: Cascade, map: "PartyDuplicateReview_secondParty_fkey")

  @@unique([tenantId, businessId, firstPartyId, secondPartyId], map: "PartyDuplicateReview_pair_key")
  @@index([tenantId, businessId, status, score], map: "PartyDuplicateReview_status_score_idx")
}
