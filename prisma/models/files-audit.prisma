enum StorageProvider {
  LOCAL
  S3
}

enum StoredFileStatus {
  AVAILABLE
  QUARANTINED
  DELETED
}

model StoredFile {
  id              String           @id @default(cuid())
  tenantId        String
  businessId      String
  storageProvider StorageProvider
  storageKey      String
  originalName    String
  safeName        String
  extension       String
  contentType     String
  sizeBytes       Int
  sha256          String
  status          StoredFileStatus @default(AVAILABLE)
  uploadedById    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade, map: "StoredFile_business_scope_fkey")
  uploadedBy      User             @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict, map: "StoredFile_uploadedById_fkey")
  attachments     FileAttachment[]

  @@unique([tenantId, businessId, id])
  @@unique([storageProvider, storageKey])
  @@index([tenantId, businessId, status, createdAt])
  @@index([tenantId, businessId, sha256])
}

model FileAttachment {
  id         String     @id @default(cuid())
  tenantId   String
  businessId String
  fileId     String
  entityType String
  entityId   String
  label      String?
  createdAt  DateTime   @default(now())
  file       StoredFile @relation(fields: [tenantId, businessId, fileId], references: [tenantId, businessId, id], onDelete: Cascade, map: "FileAttachment_file_scope_fkey")

  @@unique([tenantId, businessId, fileId, entityType, entityId], map: "FileAttachment_scope_key")
  @@index([tenantId, businessId, entityType, entityId], map: "FileAttachment_entity_idx")
}

model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  businessId  String
  actorUserId String?
  eventType   String
  entityType  String
  entityId    String
  summary     String
  metadata    Json
  occurredAt  DateTime @default(now())
  business    Business @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade, map: "AuditEvent_business_scope_fkey")
  actor       User?    @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull, map: "AuditEvent_actorUserId_fkey")

  @@index([tenantId, businessId, occurredAt], map: "AuditEvent_scope_time_idx")
  @@index([tenantId, businessId, entityType, entityId, occurredAt], map: "AuditEvent_entity_time_idx")
  @@index([tenantId, businessId, actorUserId, occurredAt], map: "AuditEvent_actor_time_idx")
}
