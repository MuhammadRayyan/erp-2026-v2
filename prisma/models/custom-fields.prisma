enum CustomFieldEntityType {
  PARTY
  CATALOG_ITEM
}

enum CustomFieldValueType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model CustomFieldDefinition {
  id          String                @id @default(cuid())
  tenantId    String
  businessId  String
  entityType  CustomFieldEntityType
  key         String
  label       String
  description String?
  valueType   CustomFieldValueType
  required    Boolean               @default(false)
  active      Boolean               @default(true)
  sortOrder   Int                   @default(0)
  options     Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  business    Business              @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade, map: "CustomFieldDefinition_business_scope_fkey")
  values      CustomFieldValue[]

  @@unique([tenantId, businessId, id], map: "CustomFieldDefinition_scope_id_key")
  @@unique([tenantId, businessId, id, entityType, valueType], map: "CustomFieldDefinition_scope_id_type_key")
  @@unique([tenantId, businessId, entityType, key], map: "CustomFieldDefinition_scope_entity_key_key")
  @@index([tenantId, businessId, entityType, active, sortOrder], map: "CustomFieldDefinition_scope_entity_active_order_idx")
}

model CustomFieldValue {
  id              String                @id @default(cuid())
  tenantId        String
  businessId      String
  definitionId    String
  entityType      CustomFieldEntityType
  valueType       CustomFieldValueType
  entityId        String
  textValue       String?
  numberValue     Decimal?              @db.Decimal(19, 4)
  dateValue       DateTime?             @db.Date
  booleanValue    Boolean?
  updatedByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  definition      CustomFieldDefinition @relation(fields: [tenantId, businessId, definitionId, entityType, valueType], references: [tenantId, businessId, id, entityType, valueType], onDelete: Cascade, map: "CustomFieldValue_definition_scope_fkey")
  updatedBy       User                  @relation("CustomFieldValueUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict, map: "CustomFieldValue_updatedByUserId_fkey")

  @@unique([tenantId, businessId, definitionId, entityId], map: "CustomFieldValue_scope_definition_entity_key")
  @@index([tenantId, businessId, entityType, entityId], map: "CustomFieldValue_scope_entity_record_idx")
  @@index([tenantId, businessId, definitionId], map: "CustomFieldValue_scope_definition_idx")
}
